	v, _, cleanup := createTestVault(t)
	defer cleanup()

	mgr, _ := createTestManager(t, v)

	// Add
	itm := &types.Item{
		Name: "Test Login",
		Type: types.ItemTypeLogin,
		Fields: map[string]string{
			types.FieldUsername: "testuser",
			types.FieldPassword: "testpass",
			types.FieldURL:      "https://test.com",
