package main

import (
	"bytes"
	"encoding/json"
	"io"
	"net/http"
	"net/http/httptest"
	"path/filepath"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	syncserver "github.com/zeropass/zeropass/core/sync/server"
	"github.com/zeropass/zeropass/core/sync/protocol"
)

type smokeHarness struct {
