func TestOpenExistingDB(t *testing.T) {
	dbPath := filepath.Join(t.TempDir(), "index.db")
	idx, err := Open(dbPath)
	require.NoError(t, err)
	require.NoError(t, idx.AddToIndex(&types.Item{
		ID: "persist", Type: types.ItemTypeLogin, Name: "Persist",
