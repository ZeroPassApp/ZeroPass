                    }
                }
                .textFieldStyle(.plain)
                .font(.callout.weight(.medium))
                .autocorrectionDisabled()
                .textContentType(.password)
                .privacySensitive()
                .focused($isPasswordFocused)
                .onSubmit(onSubmit)
                .accessibilityLabel("Master password")
