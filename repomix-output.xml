	require.NoError(t, os.WriteFile(dbPath, []byte("this is not a sqlite database at all"), 0600))

	// Attempt to open — should fail at PRAGMA or createTables
	idx, err := Open(dbPath)
	if err != nil {
		assert.Error(t, err)
		return
	}
